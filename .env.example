# Copy to .env.local.
#
# Quickest start: leave everything as is. DATA_SOURCE=local runs the app from
# the seed content with in-memory accounts, and PAYMENT_GATEWAY=mock gives a
# fake "pay" screen. Sign in with the "Dev sign-in" button.

DATA_SOURCE=local            # local | firestore
PAYMENT_GATEWAY=mock         # mock | cashfree
APP_URL=http://localhost:3000
DEV_SESSION_SECRET=change-me-for-local-dev

# --- Firebase (needed when DATA_SOURCE=firestore) ---------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
FIREBASE_PROJECT_ID=
# Either use the emulators (firebase emulators:start) ...
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_URL=http://127.0.0.1:9099
# ... or a service account for a real project (never commit it):
# FIREBASE_SERVICE_ACCOUNT_JSON=

# --- Cashfree (needed when PAYMENT_GATEWAY=cashfree) ------------------------
CASHFREE_ENV=sandbox         # sandbox | production
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
CASHFREE_API_VERSION=2026-01-01
