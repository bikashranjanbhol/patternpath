      "time": "O(n)",
      "space": "O(1)",
      "complexityWhy": "left only moves right and right only moves left, so together they visit each character at most once. Only two indexes are stored, no copies.",
      "bottleneck": "",
      "insight": "It stops at the first mismatch, so a string that isn't a palindrome is usually rejected after a few steps.",
      "code": {
        "python": "def isPalindrome(s):\n    left, right = 0, len(s) - 1\n    while left < right:\n        while left < right and not s[left].isalnum():\n            left += 1\n        while left < right and not s[right].isalnum():\n            right -= 1\n        if s[left].lower() != s[right].lower():\n            return False\n        left += 1\n        right -= 1\n    return True"
      },
