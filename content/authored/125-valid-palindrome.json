  "solutions": [
    {
      "id": "clean-and-reverse",
      "problemId": "125-valid-palindrome",
      "order": 1,
      "name": "Clean it, then compare with its reverse",
      "kind": "brute",
      "tier": "free",
      "time": "O(n)",
      "space": "O(n)",
      "complexityWhy": "One pass builds the cleaned string, reversing it is another pass, and comparing is a third: O(n) in total. The cleaned copy and its reverse take O(n) extra memory.",
      "bottleneck": "It makes two full copies of the string just to compare it with itself, and it always reads everything, even when the first and last letters already differ.",
      "insight": "Comparing with the reverse just means comparing the first letter with the last, the second with the second-to-last, and so on. Two pointers can do that on the original string, skipping the punctuation as they go.",
      "code": {
        "python": "def isPalindrome(s):\n    cleaned = \"\"\n    for i, ch in enumerate(s):\n        if ch.isalnum():\n            cleaned += ch.lower()\n    return cleaned == cleaned[::-1]"
      },
