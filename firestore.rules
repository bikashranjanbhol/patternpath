rules_version = '2';

// See "PatternPath — Database Design (Firestore)". The browser can read public
// content and its own user data only. Solutions, orders, payment events and
// coupons have no rules, so only the server (Admin SDK) can touch them.
service cloud.firestore {
  match /databases/{db}/documents {
    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    function isPremium() {
      return signedIn()
        && request.auth.token.premiumUntil is number
        && request.auth.token.premiumUntil > request.time.toMillis();
    }

    // Public content: read-only
    match /patterns/{id} { allow read: if resource.data.published == true; }
    match /plans/{id}    { allow read: if true; }
    match /problems/{id} {
      allow read: if resource.data.published == true;
      // problems/{id}/solutions: no rule = server-only
    }
    match /concepts/{id} {
      allow read: if resource.data.published == true;
      match /comments/{cid} {
        allow read: if resource.data.hidden == false;
        allow create: if signedIn()
          && request.resource.data.authorUid == request.auth.uid
          && request.resource.data.votes == 0
          && request.resource.data.hidden == false
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 2000;
        // comments/{cid}/votes: no rule = server-only
      }
    }

    // User data: owner only
    match /users/{uid} {
      allow read: if isOwner(uid);
      allow update: if isOwner(uid)
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['prefs', 'stats', 'drillsToday', 'lastSeenAt'])
        && (isPremium() || request.resource.data.drillsToday.count <= 5);
      match /{sub}/{docId} {
        allow read, write: if isOwner(uid)
          && sub in ['progress', 'patternProgress', 'reviews'];
      }
    }

    // orders, paymentEvents, coupons: no rules = server-only
  }
}
