 "p567": {
  "code": "from collections import Counter\n\ndef checkInclusion(s1, s2):\n    k = len(s1)\n    need = Counter(s1)\n    window = Counter(s2[:k])\n    if window == need:\n        return True\n    for right in range(k, len(s2)):\n        window[s2[right]] += 1\n        out = s2[right - k]\n        window[out] -= 1\n        if window[out] == 0:\n            del window[out]\n        if window == need:\n            return True\n    return False",
